[
    {
        "app": "github",
        "event": [
            {
                "name": "push",
                "method": "GET",
                "projectLink": "{server}/{userNameApp}/{projectName}",
                "apiInfo": "api.github.com/repos/{userNameApp}/{projectName}",
                "important": {
                    "id": "sha",
                    "time": "commit|committer|date",
                    "task": "commit|message",
                    "actor": "commit|committer|name"
                }
            }
        ]
    },
    {
        "app": "gitlab",
        "event": [
            {
                "name": "push",
                "method": "GET",
                "projectLink": "{server}/{userNameApp}/{projectName}",
                "apiInfo": "gitlab.com/api/v4/projects/{userNameApp}%2F{projectLink}/repository/commits",
                "important": {
                    "id": "id",
                    "time": "created_at",
                    "task": "title",
                    "actor": "committer_name"
                }
            }
        ]
    },
    {
        "app": "AutoCAD",
        "event": [
            {
                "name": "Open file",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "C:\\Users\\{userNameApp}\\AppData\\Local\\Autodesk\\AutoCAD 2024\\R24.0\\enu",
                "important": "[{time}] Opening drawing: {task}"
            },
            {
                "name": "Close file",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "C:\\Users\\{userNameApp}\\AppData\\Local\\Autodesk\\AutoCAD 2024\\R24.0\\enu",
                "important": "[{time}] Closing drawing: {task}"
            }
        ]
    },
    {
        "app": "SIMATIC WinCC V8",
        "event": [
            {
                "name": "INFO tag start",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "C:\\Program Files(x86)\\Siemens\\WinCC\\Diagnose",
                "important": "[{time}] INFO [{task}] {task} started for '{artifact}' by user '{userNameApp}'."
            },
            {
                "name": "INFO tag complete",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "C:\\Program Files(x86)\\Siemens\\WinCC\\Diagnose",
                "important": "[{time}] INFO [{task}] {task} completed for '{artifact}' by user '{userNameApp}'."
            }
        ]
    },
    {
        "app": "Matlab/Simulink",
        "event": [
            {
                "name": "INFO simulation start",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "{projectDir}\\simulink_log.txt",
                "important": "[{time}] INFO [Simulation] Starting simulation for model '{task}'."
            },
            {
                "name": "INFO simulation complete",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "{projectDir}\\simulink_log.txt",
                "important": "[{time}] INFO [Simulation] Simulation completed for model '{task}'."
            }
        ]
    },
    {
        "app": "chasca",
        "event": [
            {
                "name": "Hunt start",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "{projectDir}/chasca_log.txt",
                "important": "[{time}] INFO [Hunt] Starting hunt for '{task}'."
            },
            {
                "name": "Hunt complete",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "{projectDir}/chasca_log.txt",
                "important": "[{time}] INFO [Hunt] Hunt completed for '{task}'."
            }
        ]
    },
    {
        "app": "autopsy",
        "event": [
            {
                "name": "create-case",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "/opt/homebrew/var/lib/autopsy/{projectIdr}/case.log",
                "important": "{time}: Case {projectIdr} created"
            },
            {
                "name": "add-host",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "/opt/homebrew/var/lib/autopsy/{projectIdr}/case.log",
                "important": "{time}: Host {targetDevice} added to case"
            },
            {
                "name": "add-data-source",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "/opt/homebrew/var/lib/autopsy/{projectIdr}/{targetDevice}/logs/host.log",
                "important": "{time}: Image added: image img1 raw  {targetDataSource}"
            },
            {
                "name": "keyword-search",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "/opt/homebrew/var/lib/autopsy/{projectIdr}/{targetDevice}/logs/{userNameApp}.log",
                "important": "{time}: {targetDataSource}: ASCII, Unicode, search for {keyword}"
            },
            {
                "name": "file-search",
                "method": "LOG",
                "projectLink": "",
                "apiInfo": "/opt/homebrew/var/lib/autopsy/{projectIdr}/{targetDevice}/logs/{userNameApp}.log",
                "important": "{time}: {targetDataSource}: Directory listing of {partition}"
            }
        ]
    },
    {
        "app": "dc3dd",
        "event": [
            {
                "name": "create-image",
                "method": "bash",
                "projectLink": "",
                "apiInfo": "cat ~/.zsh_history | grep dc3dd",
                "important": "sudo dc3dd if={artifact1} of={artifact2} hash=md5"
            }
        ]
    }
]