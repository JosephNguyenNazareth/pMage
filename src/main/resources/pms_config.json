                "return" : {
                    "taskInstanceId": {
                        "body" : "id"
                    }
                }
            },
            "validateTask" : {
                "method" : "GET",
                "url" : "{pmsUrl}/{processInstanceId}/validate-task",
                "param" : ["taskName","actorName"]
            },
            "startTask" : {
                "method" : "PUT",
                "url" : "{pmsUrl}/{processInstanceId}/start-task",
                "param" : ["taskName","actorName"]
            },
            "updateArtifact" : {
                "method" : "PUT",
                "url" : "{pmsUrl}/{processInstanceId}/update-artifact",
                "param" : ["artifactName","actorName"]
            },
            "endTask" : {
                "method" : "PUT",
                "url" : "{pmsUrl}/{processInstanceId}/end-task",
                "param" : ["taskInstanceId"],
                "require" : {
                    "param" : {
                        "dynamic" : {
