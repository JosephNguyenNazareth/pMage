            "CANCELLED" : "",
            "SUSPENDED" : "waiting"
        },
        "api_info": {
            "verify": {
                "method" : "GET",
                "url" : "{pmsUrl}/{processInstanceId}",
                "param" : []
            },
            "createProcess": {
                "method" : "POST",
                "url" : "{pmsUrl}",
                "param" : ["processName","creatorName"]
            },
            "changeProcessState" : {
                "method" : "PUT",
                "url" : "{pmsUrl}/{processInstanceId}/change-state",
                "param" : ["processInstanceState"]
            },
            "getTasks" : {
