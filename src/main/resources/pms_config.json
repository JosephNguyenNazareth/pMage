                            }
                        }
                    }
                }
            },
            "getArtifact" : {
                "method": "GET",
                "url": "{pmsUrl}/{processInstanceId}/data-object",
                "param": []
            },
            "log" : {
                "method": "GET",
                "url": "{pmsUrl}/log",
                "param": []
            }
        }
    },
